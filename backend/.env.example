PORT=5000
NODE_ENV=development

# PostgreSQL connection string handled by Prisma
DATABASE_URL="postgresql://workspace_user:workspace_secure_password@localhost:5432/workspace_db?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT configuration
JWT_SECRET="super_secret_jwt_access_key_change_in_production"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_change_in_production"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Allowed frontend origin for CORS
CORS_ORIGIN="http://localhost:3000"
