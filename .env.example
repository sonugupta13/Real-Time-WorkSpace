# Root Docker Compose Environment Configuration

# PostgreSQL Configuration
POSTGRES_USER=workspace_user
POSTGRES_PASSWORD=workspace_secure_password
POSTGRES_DB=workspace_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=5000
DATABASE_URL=postgresql://workspace_user:workspace_secure_password@postgres:5432/workspace_db?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:5000
